{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xunlei.example/schemas/run-receipt.schema.json",
  "title": "AI 编码统一验证运行凭证",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "status",
    "started_at",
    "ended_at",
    "duration_ms",
    "git_dirty",
    "source_fingerprint",
    "source_file_count",
    "environment",
    "skills_loaded",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "partial",
        "failed"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "git_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "git_dirty": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "source_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "environment": {
      "type": "object",
      "required": [
        "os",
        "powershell",
        "node",
        "npm"
      ]
    },
    "skills_loaded": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "command",
          "status",
          "exit_code",
          "duration_ms"
        ],
        "properties": {
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "failure": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
