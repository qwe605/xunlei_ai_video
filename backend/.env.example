MINIMAX_API_KEY=replace-with-your-key
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimaxi.com
DATABASE_URL=sqlite:///./data/xunlei.db
XUNLEI_ASR_ENGINE=funasr
XUNLEI_ASR_MODEL=paraformer-zh
XUNLEI_ASR_DEVICE=cpu
XUNLEI_ASR_COMPUTE_TYPE=int8
XUNLEI_PRECISE_ASR_MODEL=large-v3
XUNLEI_PRECISE_MODEL_PATH=./models/faster-whisper-large-v3
XUNLEI_PRECISE_ASR_DEVICE=cpu
XUNLEI_PRECISE_ASR_COMPUTE_TYPE=int8
XUNLEI_PRELOAD_ASR=true
HF_HUB_DISABLE_XET=1
